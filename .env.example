# SafeAid AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.

# Google Gemini API key — obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (gemini-2.5-flash is recommended)
GEMINI_MODEL=gemini-2.5-flash

# Express server port (default: 5000)
PORT=5000

# Allowed CORS origin for the frontend (use * only for local dev, never production)
ALLOWED_ORIGIN=http://localhost:5173
